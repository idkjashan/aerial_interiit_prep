@@ -0,0 +1,9 @@
+# Runtime effectiveness scaling of a single rotor, as applied by the control allocator.
+# Set through CA_EFF_MOTOR / CA_EFF_SCALE. Published whenever the effectiveness matrix
+# is rebuilt and once per second otherwise.
+
+uint64 timestamp                # time since system start (microseconds)
+
+uint8 motor                     # motor number (1-based, as in CA_EFF_MOTOR), 0 if none selected
+float32 scale                   # scalar applied to that motor's effectiveness column [0, 1]
+float32[6] effectiveness        # the motor's column as used by the allocator: roll, pitch, yaw torque, thrust x, y, z
diff --git a/src/modules/control_allocator/ControlAllocator.cpp b/src/modules/control_allocator/ControlAllocator.cpp
index e0dc14b..5d12e66 100644
--- a/src/modules/control_allocator/ControlAllocator.cpp
+++ b/src/modules/control_allocator/ControlAllocator.cpp
@@ -45,6 +45,7 @@
 #include <circuit_breaker/circuit_breaker.h>
 #include <mathlib/math/Limits.hpp>
 #include <mathlib/math/Functions.hpp>
+#include <systemlib/mavlink_log.h>
 
 using namespace matrix;
 using namespace time_literals;
@@ -120,6 +121,7 @@ ControlAllocator::parameters_updated()
 	// Allocation method & effectiveness source
 	// Do this first: in case a new method is loaded, it will be configured below
 	bool updated = update_effectiveness_source();
+	const bool allocators_recreated = updated || _allocation_method_id != (AllocationMethod)_param_ca_method.get();
 	update_allocation_method(updated); // must be called after update_effectiveness_source()
 
 	if (_num_control_allocation == 0) {
@@ -130,9 +132,52 @@ ControlAllocator::parameters_updated()
 		_control_allocation[i]->updateParameters();
 	}
 
+	update_rotor_effectiveness_scale(allocators_recreated);
+
 	update_effectiveness_matrix_if_needed(EffectivenessUpdateReason::CONFIGURATION_UPDATE);
 }
 
+void
+ControlAllocator::update_rotor_effectiveness_scale(bool allocators_recreated)
+{
+	const int motor_idx = _param_ca_eff_motor.get() - 1;
+	float scale = _param_ca_eff_scale.get();
+	scale = PX4_ISFINITE(scale) ? math::constrain(scale, 0.f, 1.f) : 1.f;
+
+	// CA_EFF_SCALE is a flight-test input. New allocator objects (at startup, or after
+	// CA_AIRFRAME / CA_METHOD changed) take their normalization from the first matrix they
+	// see, so that matrix has to be the healthy one.
+	if (allocators_recreated && scale < 1.f) {
+		PX4_WARN("allocation (re)configured, CA_EFF_SCALE reset to 1");
+		_param_ca_eff_scale.set(1.f);
+		_param_ca_eff_scale.commit_no_notification();
+		scale = 1.f;
+	}
+
+	const float new_scale = (motor_idx >= 0) ? scale : 1.f;
+
+	if (motor_idx != _eff_motor_idx || fabsf(new_scale - _eff_scale) > FLT_EPSILON) {
+		if (motor_idx >= 0) {
+			// also printed on the PX4 console
+			mavlink_log_info(&_mavlink_log_pub, "Motor %d effectiveness %.0f%%", motor_idx + 1, (double)(new_scale * 100.f));
+
+		} else if (_eff_motor_idx >= 0) {
+			PX4_INFO("rotor effectiveness scaling off");
+		}
+	}
+
+	_eff_motor_idx = motor_idx;
+	_eff_scale = new_scale;
+
+	// While a rotor is scaled down keep the normalization of the healthy geometry, as the
+	// built-in motor failure handling does. Re-normalizing on the scaled matrix would change
+	// the gain from the rate controller's normalized torque to motor output on every axis.
+	// (Parameter updates only get here when no motor failure is being handled.)
+	for (int i = 0; i < _num_control_allocation; ++i) {
+		_control_allocation[i]->setHadActuatorFailure(_eff_scale < 1.f);
+	}
+}
+
 void
 ControlAllocator::update_allocation_method(bool force)
 {
@@ -457,6 +502,10 @@ ControlAllocator::Run()
 		_last_status_pub = now;
 	}
 
+	if (now - _last_rotor_effectiveness_pub >= 1_s) {
+		publish_rotor_effectiveness();
+	}
+
 	perf_end(_loop_perf);
 }
 
@@ -536,19 +585,38 @@ ControlAllocator::update_effectiveness_matrix_if_needed(EffectivenessUpdateReaso
 			}
 		}
 
-		// Handle failed actuators
-		if (_handled_motor_failure_bitmask) {
+		if (_eff_motor_idx >= _num_actuators[0]) {
+			PX4_WARN("CA_EFF_MOTOR %d ignored, only %d motors", _eff_motor_idx + 1, _num_actuators[0]);
+			_eff_motor_idx = -1;
+			_eff_scale = 1.f;
+
+			for (int i = 0; i < _num_control_allocation; ++i) {
+				_control_allocation[i]->setHadActuatorFailure(_handled_motor_failure_bitmask != 0);
+			}
+		}
+
+		// Handle failed actuators, and the runtime effectiveness scale of one motor.
+		// Both act on the motor's whole column: roll, pitch, yaw torque and thrust.
+		_eff_column.setZero();
+
+		if (_handled_motor_failure_bitmask || _eff_motor_idx >= 0) {
 			actuator_idx = 0;
 			memset(&actuator_idx_matrix, 0, sizeof(actuator_idx_matrix));
 
 			for (int motors_idx = 0; motors_idx < _num_actuators[0] && motors_idx < actuator_motors_s::NUM_CONTROLS; motors_idx++) {
 				int selected_matrix = _control_allocation_selection_indexes[actuator_idx];
+				ActuatorEffectiveness::EffectivenessMatrix &matrix = config.effectiveness_matrices[selected_matrix];
+				const int column = actuator_idx_matrix[selected_matrix];
 
 				if (_handled_motor_failure_bitmask & (1 << motors_idx)) {
-					ActuatorEffectiveness::EffectivenessMatrix &matrix = config.effectiveness_matrices[selected_matrix];
+					for (int i = 0; i < NUM_AXES; i++) {
+						matrix(i, column) = 0.0f;
+					}
 
+				} else if (motors_idx == _eff_motor_idx) {
 					for (int i = 0; i < NUM_AXES; i++) {
-						matrix(i, actuator_idx_matrix[selected_matrix]) = 0.0f;
+						matrix(i, column) *= _eff_scale;
+						_eff_column(i) = matrix(i, column);
 					}
 				}
 
@@ -590,9 +658,27 @@ ControlAllocator::update_effectiveness_matrix_if_needed(EffectivenessUpdateReaso
 
 		trims.timestamp = hrt_absolute_time();
 		_actuator_servos_trim_pub.publish(trims);
+
+		publish_rotor_effectiveness();
 	}
 }
 
+void
+ControlAllocator::publish_rotor_effectiveness()
+{
+	rotor_effectiveness_s rotor_effectiveness{};
+	rotor_effectiveness.motor = static_cast<uint8_t>(_eff_motor_idx + 1);
+	rotor_effectiveness.scale = _eff_scale;
+
+	for (int i = 0; i < NUM_AXES; i++) {
+		rotor_effectiveness.effectiveness[i] = _eff_column(i);
+	}
+
+	rotor_effectiveness.timestamp = hrt_absolute_time();
+	_rotor_effectiveness_pub.publish(rotor_effectiveness);
+	_last_rotor_effectiveness_pub = rotor_effectiveness.timestamp;
+}
+
 void
 ControlAllocator::publish_control_allocator_status(int matrix_index)
 {
@@ -832,6 +918,10 @@ int ControlAllocator::print_status()
 			 _handled_motor_failure_bitmask);
 	}
 
+	if (_eff_motor_idx >= 0) {
+		PX4_INFO("Motor %i effectiveness scaled to %.2f", _eff_motor_idx + 1, (double)_eff_scale);
+	}
+
 	// Print perf
 	perf_print_counter(_loop_perf);
 
