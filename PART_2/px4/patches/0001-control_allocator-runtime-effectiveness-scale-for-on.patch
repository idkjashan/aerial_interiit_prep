diff --git a/src/modules/control_allocator/module.yaml b/src/modules/control_allocator/module.yaml
index 99d0d5e..863a073 100644
--- a/src/modules/control_allocator/module.yaml
+++ b/src/modules/control_allocator/module.yaml
@@ -592,6 +592,34 @@ parameters:
                 1: Remove first failed motor from effectiveness
             default: 0
 
+        CA_EFF_MOTOR:
+            description:
+                short: Motor whose effectiveness is scaled at runtime
+                long: |
+                    Motor number (1-based, same numbering as 'failure motor -i') whose
+                    column in the effectiveness matrix is multiplied by CA_EFF_SCALE.
+                    0 disables the scaling. Only the allocator's model of the rotor
+                    changes; the motor output itself is not overridden.
+            type: int32
+            min: 0
+            max: 12
+            default: 0
+
+        CA_EFF_SCALE:
+            description:
+                short: Effectiveness scale of the motor selected by CA_EFF_MOTOR
+                long: |
+                    1 is nominal, 0 removes the motor from the allocation. Takes effect
+                    on the next parameter update, also in flight. Reset to 1 at startup
+                    and when CA_AIRFRAME or CA_METHOD change, so the allocator
+                    normalization is always taken from the healthy geometry.
+            type: float
+            min: 0.0
+            max: 1.0
+            decimal: 2
+            increment: 0.05
+            default: 1.0
+
